{
  "expo": {
    "name": "BibliaApp",
    "slug": "BibliaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/biblialogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/biblialogo.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.lucaodevelop2.BibliaApp"
    },
    "splash": {
      "image": "./assets/biblialogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "06f9b5f1-7df5-4d34-b054-b35cd79bf5c7"
      }
    }
  }
}
